generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admins {
  admin_id        Int               @id @default(autoincrement())
  full_name       String            @db.VarChar(100)
  username        String            @unique(map: "username") @db.VarChar(50)
  password        String            @db.VarChar(255)
  email           String            @unique(map: "email") @db.VarChar(100)
  role            String?           @default("admin") @db.VarChar(50)
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  updated_at      DateTime?         @default(now()) @db.Timestamp(0)
  last_login_at   DateTime?         @db.DateTime(0)
  contact_replies contact_replies[]
  payments        payments[]
}

model cart_items {
  cart_item_id Int       @id @default(autoincrement())
  user_id      Int
  product_id   Int
  qty          Int       @default(1)
  color        String?   @db.VarChar(50)
  size         String?   @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.DateTime(0)
  updated_at   DateTime? @default(now()) @db.DateTime(0)
  products     products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, map: "fk_cart_items_products")
  users        users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_cart_items_users")

  @@index([product_id], map: "fk_cart_items_products")
  @@index([user_id], map: "fk_cart_items_users")
}

model categories {
  category_id   Int        @id @default(autoincrement())
  category_name String     @db.VarChar(100)
  category_slug String     @unique(map: "category_slug") @db.VarChar(100)
  description   String?    @db.Text
  created_at    DateTime?  @default(now()) @db.Timestamp(0)
  updated_at    DateTime?  @default(now()) @db.Timestamp(0)
  products      products[]
}

model contact_replies {
  reply_id            Int       @id @default(autoincrement())
  contact_id          Int
  admin_id            Int
  reply_message       String    @db.Text
  is_read_by_customer Boolean?  @default(false)
  email_sent          Boolean?  @default(false)
  email_error         String?   @db.VarChar(255)
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  admins              admins    @relation(fields: [admin_id], references: [admin_id], map: "fk_contact_replies_admins")
  contacts            contacts  @relation(fields: [contact_id], references: [contact_id], onDelete: Cascade, map: "fk_contact_replies_contacts")

  @@index([admin_id], map: "fk_contact_replies_admins")
  @@index([contact_id], map: "fk_contact_replies_contacts")
}

model contacts {
  contact_id      Int               @id @default(autoincrement())
  contact_name    String            @db.VarChar(100)
  contact_email   String            @db.VarChar(100)
  contact_phone   String?           @db.VarChar(20)
  contact_subject String?           @db.VarChar(100)
  contact_message String            @db.Text
  status          String?           @default("pending") @db.VarChar(50)
  created_at      DateTime?         @default(now()) @db.Timestamp(0)
  updated_at      DateTime?         @default(now()) @db.Timestamp(0)
  contact_replies contact_replies[]
}

model order_items {
  order_item_id Int       @id @default(autoincrement())
  order_id      Int
  product_id    Int?
  product_name  String    @db.VarChar(255)
  unit_price    Decimal   @db.Decimal(10, 2)
  quantity      Int
  subtotal      Decimal   @db.Decimal(10, 2)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  orders        orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, map: "fk_order_items_orders")
  products      products? @relation(fields: [product_id], references: [product_id], map: "fk_order_items_products")

  @@index([order_id], map: "fk_order_items_orders")
  @@index([product_id], map: "fk_order_items_products")
}

model orders {
  order_id          Int                @id @default(autoincrement())
  order_number      String             @unique(map: "order_number") @db.VarChar(20)
  customer_name     String             @db.VarChar(150)
  customer_phone    String             @db.VarChar(20)
  customer_email    String?            @db.VarChar(100)
  shipping_address  String             @db.Text
  total_price       Decimal            @default(0.00) @db.Decimal(10, 2)
  order_status      String?            @default("pending") @db.VarChar(50)
  payment_status    String?            @default("unpaid") @db.VarChar(50)
  payment_type      String?            @db.VarChar(50)
  shipping_status   String?            @default("pending") @db.VarChar(50)
  rider_id          Int?
  latitude          Decimal?           @db.Decimal(10, 8)
  longitude         Decimal?           @db.Decimal(11, 8)
  location_valid    Boolean?           @default(false)
  location_source   String?            @db.VarChar(50)
  distance_km       Decimal?           @db.Decimal(10, 2)
  rider_fee         Decimal?           @default(0.00) @db.Decimal(10, 2)
  shipping_fee      Decimal?           @default(0.00) @db.Decimal(10, 2)
  user_id           Int?
  notes             String?            @db.Text
  ordered_at        DateTime?          @default(now()) @db.DateTime(0)
  delivered_at      DateTime?          @db.DateTime(0)
  status_updated_at DateTime?          @db.DateTime(0)
  created_at        DateTime?          @default(now()) @db.Timestamp(0)
  updated_at        DateTime?          @default(now()) @db.Timestamp(0)
  order_items       order_items[]
  riders            riders?            @relation(fields: [rider_id], references: [rider_id], map: "fk_orders_riders")
  users             users?             @relation(fields: [user_id], references: [user_id], map: "fk_orders_users")
  payments          payments[]
  product_reviews   product_reviews[]
  shipping_reviews  shipping_reviews[]
  staff_reviews     staff_reviews[]

  @@index([rider_id], map: "fk_orders_riders")
  @@index([user_id], map: "fk_orders_users")
}

model payments {
  payment_id            Int       @id @default(autoincrement())
  order_id              Int
  payment_method        String    @db.VarChar(50)
  payment_amount        Decimal   @db.Decimal(10, 2)
  payment_date          DateTime? @db.DateTime(0)
  transaction_reference String?   @db.VarChar(100)
  payment_slip          String?   @db.VarChar(255)
  payment_status        String?   @default("pending") @db.VarChar(50)
  verified_by           Int?
  verified_at           DateTime? @db.DateTime(0)
  payment_note          String?   @db.Text
  created_at            DateTime? @default(now()) @db.Timestamp(0)
  updated_at            DateTime? @default(now()) @db.Timestamp(0)
  admins                admins?   @relation(fields: [verified_by], references: [admin_id], map: "fk_payments_admins")
  orders                orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, map: "fk_payments_orders")

  @@index([verified_by], map: "fk_payments_admins")
  @@index([order_id], map: "fk_payments_orders")
}

model product_reviews {
  review_id     Int       @id @default(autoincrement())
  order_id      Int
  product_id    Int
  user_id       Int
  rating        Int       @db.TinyInt
  comment       String?   @db.Text
  size_fit      String?   @db.VarChar(50)
  hide_username Boolean?  @default(false)
  is_approved   Boolean?  @default(false)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  updated_at    DateTime? @default(now()) @db.Timestamp(0)
  orders        orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, map: "fk_product_reviews_orders")
  products      products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, map: "fk_product_reviews_products")
  users         users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_product_reviews_users")

  @@index([order_id], map: "fk_product_reviews_orders")
  @@index([product_id], map: "fk_product_reviews_products")
  @@index([user_id], map: "fk_product_reviews_users")
}

model products {
  product_id      Int               @id @default(autoincrement())
  product_name    String            @db.VarChar(255)
  category_id     Int
  price           Decimal           @default(0.00) @db.Decimal(10, 2)
  stock           Int               @default(0)
  image           String?           @db.VarChar(255)
  description     String?           @db.Text
  sku             String?           @unique(map: "sku") @db.VarChar(50)
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.DateTime(0)
  updated_at      DateTime?         @default(now()) @db.DateTime(0)
  cart_items      cart_items[]
  order_items     order_items[]
  product_reviews product_reviews[]
  categories      categories        @relation(fields: [category_id], references: [category_id], map: "fk_products_categories")
  wishlist        wishlist[]

  @@index([category_id], map: "fk_products_categories")
}

model riders {
  rider_id       Int             @id @default(autoincrement())
  full_name      String          @db.VarChar(150)
  phone          String          @db.VarChar(20)
  email          String?         @db.VarChar(100)
  rider_code     String          @unique(map: "rider_code") @db.VarChar(10)
  vehicle_type   String?         @db.VarChar(50)
  license_number String?         @db.VarChar(50)
  is_active      Boolean?        @default(true)
  created_at     DateTime?       @default(now()) @db.Timestamp(0)
  updated_at     DateTime?       @default(now()) @db.Timestamp(0)
  orders         orders[]
  staff_reviews  staff_reviews[]
}

model shipping_reviews {
  review_id  Int       @id @default(autoincrement())
  order_id   Int
  user_id    Int
  rating     Int       @db.TinyInt
  comment    String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  orders     orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, map: "fk_shipping_reviews_orders")
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_shipping_reviews_users")

  @@index([order_id], map: "fk_shipping_reviews_orders")
  @@index([user_id], map: "fk_shipping_reviews_users")
}

model staff_reviews {
  review_id  Int       @id @default(autoincrement())
  order_id   Int
  staff_id   Int
  user_id    Int
  rating     Int       @db.TinyInt
  comment    String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  orders     orders    @relation(fields: [order_id], references: [order_id], onDelete: Cascade, map: "fk_staff_reviews_orders")
  riders     riders    @relation(fields: [staff_id], references: [rider_id], map: "fk_staff_reviews_riders")
  users      users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_staff_reviews_users")

  @@index([order_id], map: "fk_staff_reviews_orders")
  @@index([staff_id], map: "fk_staff_reviews_riders")
  @@index([user_id], map: "fk_staff_reviews_users")
}

model users {
  user_id           Int                @id @default(autoincrement())
  email             String             @unique(map: "email") @db.VarChar(150)
  username          String             @db.VarChar(50)
  password          String?            @db.VarChar(255)
  facebook_id       String?            @db.VarChar(50)
  google_id         String?            @db.VarChar(50)
  phone             String?            @db.VarChar(20)
  address           String?            @db.Text
  is_active         Boolean?           @default(true)
  email_verified_at DateTime?          @db.DateTime(0)
  created_at        DateTime?          @default(now()) @db.Timestamp(0)
  updated_at        DateTime?          @default(now()) @db.Timestamp(0)
  last_login_at     DateTime?          @db.DateTime(0)
  cart_items        cart_items[]
  orders            orders[]
  product_reviews   product_reviews[]
  shipping_reviews  shipping_reviews[]
  staff_reviews     staff_reviews[]
  wishlist          wishlist[]
}

model wishlist {
  wishlist_id Int       @id @default(autoincrement())
  user_id     Int
  product_id  Int
  updated_at  DateTime? @default(now()) @db.Timestamp(0)
  products    products  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, map: "fk_wishlist_products")
  users       users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, map: "fk_wishlist_users")

  @@unique([user_id, product_id], map: "uq_wishlist_user_product")
  @@index([product_id], map: "fk_wishlist_products")
}
